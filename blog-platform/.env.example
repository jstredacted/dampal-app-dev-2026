JWT_SECRET=replace_me_with_a_long_random_value
AUTH_PORT=4000
BLOG_PORT=5000

# MariaDB from XAMPP (default: user root with no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_platform

# Max requests to the Auth Server per address every 15 minutes
AUTH_RATE_LIMIT=100
